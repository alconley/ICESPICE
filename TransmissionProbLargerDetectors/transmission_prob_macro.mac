# Auto-generated Geant4 macro for transmission probability simulations

/control/alias n 1000000

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/run/setCut 1 um
/run/initialize
/gps/ang/type iso
/gps/pos/type Point
/gps/particle e-
/gps/ene/type Mono

# --- f = 70 mm ---

/gps/pos/centre 0 0 70 mm

# --- g = 30 mm ---
/ICESPICE/DetectorPosition -30

/ICESPICE/CustomActiveArea 200 mm2

/control/alias File transmission_probability_5000umThick_200nmSiWindow_200mm2_f70mm_g30mm_n1000000_energy2000keV
/gps/ene/mono 2000 keV
/analysis/setFileName {File}
/run/printProgress 100000
/run/beamOn {n}
/control/shell cp {File}.root ../TransmissionProbLargerDetectors/data/

/control/alias File transmission_probability_5000umThick_200nmSiWindow_200mm2_f70mm_g30mm_n1000000_energy2100keV
